import java.util.Scanner;

public class operators {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter a number");
        int num = sc.nextInt();

        String result = (num % 2 == 0) ? "Even" : "Odd";
        System.out.println(result);

        sc.close();
    }
}

import java.util.*;
public class datatypes {
    public static void main(String [] args){
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter Integers");
        int a=sc.nextInt();
        int b=sc.nextInt();
        if(a>18){
            System.out.println("Eligible for voting");
        }
        else if(b>18){
            System.out.println("Eligible for voting");
        }
        else{
            System.out.println("Not eligible for voting");
        }

    }
} 
    
import java.util.Scanner;
public class condition {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter a number");
        int num = sc.nextInt();

        if (num > 0) {
            System.out.println("Positive");
        } else if (num < 0) {
            System.out.println("Negative");
        } else {
            System.out.println("Zero");
        }

        sc.close();
    }
}

import java.util.Scanner;
public class branch {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter a branch number(1-15):");
        int num = sc.nextInt();

        switch(num){
            case 1:
                System.out.println("cse");
                break;
            case 2:
                System.out.println("it");
                break;
            case 3:
                System.out.println("ece");
                break;
            case 4:
                System.out.println("eee");    
            break;
            case 5:
                System.out.println("mech");
                break;              
            case 6:
                System.out.println("civil"); 
                break;
            case 7:
                System.out.println("aero");
                break;
            case 8:
                System.out.println("biotech");
                break;
            case 9:
                System.out.println("chemical");
                break;
            case 10:
                System.out.println("petrochemical");
                break;
            case 11:
                System.out.println("textile");
                break;
            case 12:
                System.out.println("pharmaceutical");
                break;
            case 13:
                System.out.println("material");
                break;
            case 14:
                System.out.println("environmental");
                break;
            case 15:
                System.out.println("agricultural");
                break;
            default:
                System.out.println("Invalid branch");
        }
        sc.close();
    }
}
